<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.kaloyanyordanov</groupId>
    <artifactId>exchange</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>exchange</name>
    <description>Single-threaded matching engine exchange</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Default off; set -Dpitest.skip=true to run the other gates without PIT
             (useful on memory-constrained machines, where surefire and PIT together
             exceed available RAM). Mutation analysis is then run as a separate pass. -->
        <pitest.skip>false</pitest.skip>
        <!-- The React/Vite SPA is built into the jar during prepare-package (so plain
             `mvn test` stays fast and needs no Node). Set -Dfrontend.skip=true to skip
             the Node/npm build, e.g. for a backend-only package. -->
        <frontend.skip>false</frontend.skip>
        <node.version>v22.14.0</node.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- Lock-free MPSC ring buffer for the ingress queue (LMAX pattern):
             many producers offer, the single matching thread drains. -->
        <dependency>
            <groupId>org.jctools</groupId>
            <artifactId>jctools-core</artifactId>
            <version>4.0.7</version>
        </dependency>
        <!-- BCrypt for hashing trader API keys (identity only, not full auth).
             Version managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Async persistence (off the hot path): JPA + Postgres + Flyway.
             Versions managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Boot 4's starter-data-jpa does not bring the Flyway auto-config
             module; it must be added explicitly for Flyway to run migrations. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <!-- SpotBugs annotations: enables the sanctioned inline @SuppressFBWarnings
             with written justification. Provided scope (compile-time only). -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>4.10.4</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 split MockMvc/@WebMvcTest support out of starter-test
             into this first-party module. Needed for the MockMvc smoke test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Property-based testing. Core to the correctness phases; wired and
             proven runnable here. -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>1.10.1</version>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: real Postgres for the persistence integration test.
             Versions managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Builds the React/Vite SPA (src/main/frontend) into the jar. Bound to
                 prepare-package so plain `mvn test`/`compile` never touch Node; a full
                 `mvn verify`/`package` installs a pinned Node, runs a reproducible
                 `npm ci`, and builds the production bundle. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>src/main/frontend</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                    <skip>${frontend.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copies the built SPA into the classpath static root so Spring Boot
                 serves it from the jar. Runs after the npm build, same phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-bundle</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <skip>${frontend.skip}</skip>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire: default includes only match *Test/*Tests/Test*, which
                 would silently skip jqwik property classes named *Properties.
                 The correctness phases lean on those, so include them here. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*Properties.java</include>
                    </includes>
                    <!-- Run tests in UTC: this host's default zone is the retired
                         "Europe/Kiev", which modern Postgres (Testcontainers)
                         rejects at connection time. -->
                    <systemPropertyVariables>
                        <user.timezone>UTC</user.timezone>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- JaCoCo: coverage gate bound to verify — 85% line / 80% branch.
                 The Application bootstrap class is excluded: a Spring Boot main
                 method has no meaningful branches to test. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <!-- Bootstrap class: no meaningful branches. -->
                                <exclude>dev/kaloyanyordanov/exchange/Application.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Checkstyle: Google config forced to error severity, failing the
                 build on any violation. Bound to verify. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>14.1.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs: max effort, low threshold, failing the build on any
                 finding. Bound to verify. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.10.4.1</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>4.10.4</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <failOnError>true</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- PIT mutation testing. ENFORCED from Phase 1: mutationCoverage is
                 bound to verify and fails the build below a 70% mutation score.
                 PIT earns its keep on the matching/ledger branch logic. Only the
                 Application bootstrap class is excluded (as from coverage). -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>dev.kaloyanyordanov.exchange.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>dev.kaloyanyordanov.exchange.*</param>
                    </targetTests>
                    <excludedClasses>
                        <!-- Bootstrap class: excluded from mutation as from coverage. -->
                        <param>dev.kaloyanyordanov.exchange.Application</param>
                    </excludedClasses>
                    <!-- Concurrency/property tests that spawn many threads are
                         timing-dependent: using them as mutation-killing tests
                         makes PIT slow and flaky. They still run in full under
                         surefire on every `verify`; the fast, deterministic
                         processCommand/lifecycle unit tests kill the engine's
                         mutants. This scopes mutation analysis, not the suite. -->
                    <excludedTestClasses>
                        <param>*ConcurrencyTest</param>
                        <param>*ConcurrencyProperties</param>
                        <!-- Slow full-context Spring Boot tests: excluded from
                             mutation analysis (still run under surefire). Fast
                             standalone/unit tests kill the API-layer mutants. -->
                        <param>*ApiIntegrationTest</param>
                        <param>*WebSocketIntegrationTest</param>
                        <param>*PostgresIntegrationTest</param>
                        <param>*OffHotPathTest</param>
                    </excludedTestClasses>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <!-- Bounded so mutation analysis fits in constrained memory: a
                         single minion with a capped heap (the excluded slow Spring
                         tests never run here, so the fast unit tests fit easily). -->
                    <skip>${pitest.skip}</skip>
                    <threads>1</threads>
                    <jvmArgs>
                        <value>-Xmx448m</value>
                    </jvmArgs>
                    <mutationThreshold>70</mutationThreshold>
                </configuration>
                <executions>
                    <execution>
                        <id>pitest-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
